# ---- infra (docker compose overrides DATABASE_URL / REDIS_URL for containers)
DATABASE_URL=postgresql+psycopg://ec2opt:ec2opt@localhost:5432/ec2opt
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-long-random-string        # JWT signing + credential-cache encryption
ENVIRONMENT=development                              # production => Secure cookies, no /docs

# ---- platform AWS identity (required: assumes customer roles + calls the Pricing API)
PLATFORM_AWS_ACCOUNT_ID=123456789012
PLATFORM_PRINCIPAL_ARN=arn:aws:iam::123456789012:role/ec2opt-backend
PLATFORM_AWS_ACCESS_KEY_ID=                          # dev only; production uses an instance/task role
PLATFORM_AWS_SECRET_ACCESS_KEY=                      # dev only
PLATFORM_AWS_REGION=us-east-1
CFN_TEMPLATE_URL=https://YOUR-BUCKET.s3.amazonaws.com/cloudformation-role.yaml
ROLE_NAME=EC2OptimizerAccessRole

# ---- detector inputs (production defaults; quick lab test: 35 / 20 / false)
LOOKBACK_HOURS=336
MIN_HISTORY_HOURS=168
APPLY_DATA_QUALITY=true

FRONTEND_ORIGIN=http://localhost:5173
