flowchart TD
    S(( )) --> A[Open Suggestions page]
    A --> B[System loads open suggestions]
    B --> C[User reviews suggestion]
    C --> D{Choose action}

    D -- Apply --> E[Show confirmation modal]
    E --> F{Confirm?}
    F -- Cancel --> C
    F -- Apply & Monitor --> G[Snapshot current config]
    G --> H{Schedule for later?}
    H -- Yes --> I[Mark Scheduled; wait for maintenance window]
    I --> J
    H -- No --> J[Execute change on AWS]
    J --> K{Succeeded?}
    K -- No --> L[Mark Failed; log error]
    L --> M{Retry?}
    M -- Yes --> J
    M -- No --> Z
    K -- Yes --> N[Mark Applied; start 72h monitoring]
    N --> O{Rollback needed?}
    O -- "Threshold breached (auto)" --> R
    O -- "User clicks Roll back (manual)" --> R
    O -- "No, monitoring period ends" --> P[Mark change Completed]
    P --> Z

    D -- Reject --> Q[Show dismiss popover]
    Q --> Q1{Confirm?}
    Q1 -- Cancel --> C
    Q1 -- Dismiss --> Q2[Select reason]
    Q2 --> Q3[Mark Dismissed; store feedback]
    Q3 --> Q4{Restore later?}
    Q4 -- Yes --> C
    Q4 -- No --> Z

    R[Load previous config snapshot] --> R1[Restore previous config on AWS]
    R1 --> R2[Stop monitoring]
    R2 --> R3[Mark Rolled back; flag suggestion for re-evaluation]
    R3 --> Z

    Z((( )))
    style S fill:#000,stroke:#000,width:30px,height:30px
    style Z fill:#000,stroke:#000,width:30px,height:30px
